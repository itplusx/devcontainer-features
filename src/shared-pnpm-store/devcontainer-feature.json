{
    "name": "Shared pnpm Store",
    "id": "shared-pnpm-store",
    "version": "1.1.0",
    "documentationURL": "https://github.com/itplusx/devcontainer-features/tree/main/src/shared-pnpm-store",
    "description": "Mounts shared Docker volumes as the pnpm content-addressable store and the pnpm package-manager store, and sets PNPM_HOME so pnpm never falls back to the current directory. Points pnpm at the volumes via containerEnv — no pnpm invocation, no symlink.",
    "options": {},
    "containerEnv": {
        "PNPM_CONFIG_STORE_DIR": "/mnt/shared-pnpm-store",
        "NPM_CONFIG_STORE_DIR": "/mnt/shared-pnpm-store",
        "PNPM_HOME": "/usr/local/share/pnpm",
        "PNPM_CONFIG_GLOBAL_BIN_DIR": "/usr/local/share/pnpm/bin",
        "NPM_CONFIG_GLOBAL_BIN_DIR": "/usr/local/share/pnpm/bin",
        "PATH": "/usr/local/share/pnpm/bin:${PATH}"
    },
    "mounts": [
        {
            "source": "devcontainer-shared-pnpm-store",
            "target": "/mnt/shared-pnpm-store",
            "type": "volume"
        },
        {
            "source": "devcontainer-shared-pnpm-package-manager-store",
            "target": "/usr/local/share/pnpm/package-manager-store",
            "type": "volume"
        }
    ],
    "installsAfter": [
        "ghcr.io/devcontainers/features/node",
        "ghcr.io/devcontainers/features/common-utils",
        "ghcr.io/meaningful-ooo/devcontainer-features/fish"
    ],
    "onCreateCommand": {
        "shared-pnpm-store-setup": "/usr/local/share/shared-pnpm-store/scripts/oncreate.sh"
    }
}
